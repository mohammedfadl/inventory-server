server {
    listen 443 ssl http2;
    server_name inventory.example.com;
    ssl_certificate     /etc/letsencrypt/live/inventory.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inventory.example.com/privkey.pem;
    client_max_body_size 300m;                 # ملفات الاستيراد الكبيرة
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
}
server { listen 80; server_name inventory.example.com; return 301 https://$host$request_uri; }
